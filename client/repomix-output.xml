<file path="src/context/AuthContext.jsx">
import React, { createContext, useContext, useEffect, useState } from 'react';
import { supabase } from '../lib/supabaseClient';

const AuthContext = createContext({});

export const AuthProvider = ({ children }) => {
  const [user, setUser] = useState(null);
  const [profile, setProfile] = useState(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    // 1. Instantly restore session from local storage
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session?.user) {
        setUser(session.user);
        setProfile({
          id: session.user.id,
          full_name: session.user.user_metadata?.full_name || 'Student',
          role: session.user.user_metadata?.role || 'student',
        });
      }
      setLoading(false);
    });

    // 2. React to login/logout without secondary database hits
    const {
      data: { subscription },
    } = supabase.auth.onAuthStateChange((_event, session) => {
      if (session?.user) {
        setUser(session.user);
        setProfile({
          id: session.user.id,
          full_name: session.user.user_metadata?.full_name || 'Student',
          role: session.user.user_metadata?.role || 'student',
        });
      } else {
        setUser(null);
        setProfile(null);
      }
      setLoading(false);
    });

    return () => subscription.unsubscribe();
  }, []);

  const logout = () => supabase.auth.signOut();

  return (
    <AuthContext.Provider value={{ user, profile, loading, logout }}>
      {!loading && children}
    </AuthContext.Provider>
  );
};

export const useAuth = () => useContext(AuthContext);
</file>

<file path="src/pages/AdminLeaderboard.jsx">
import React, { useEffect, useState } from 'react';
import { useParams, Link } from 'react-router-dom';
import { supabase } from '../lib/supabaseClient';
import { Trophy, ArrowLeft, Clock, Award, Medal, CheckCircle2, XCircle, Users } from 'lucide-react';

export default function AdminLeaderboard() {
  const { examId } = useParams();
  const [exam, setExam] = useState(null);
  const [rankings, setRankings] = useState([]);
  const [loading, setLoading] = useState(true);
  
  // Qualification States
  const [topK, setTopK] = useState(10);
  const [isQualifying, setIsQualifying] = useState(false);

  const fetchRankings = async () => {
    setLoading(true);
    const { data: examData } = await supabase.from('exams').select('*').eq('id', examId).single();
    
    const { data: subData } = await supabase
      .from('submissions')
      .select('*')
      .eq('exam_id', examId)
      .eq('is_terminated', false)
      .order('score', { ascending: false })
      .order('time_taken_seconds', { ascending: true })
      .order('submitted_at', { ascending: true });

    setExam(examData);
    setRankings(subData || []);
    setLoading(false);
  };

  useEffect(() => {
    fetchRankings();
  }, [examId]);

  const handleQualifyTopK = async () => {
    if (topK <= 0 || rankings.length === 0) return;
    if (!window.confirm(`Are you sure you want to officially mark the Top ${topK} candidates as Qualified for the next round?`)) return;

    setIsQualifying(true);

    // rankings are already sorted by highest score -> fastest time
    const qualifiedIds = rankings.slice(0, topK).map(r => r.id);
    const disqualifiedIds = rankings.slice(topK).map(r => r.id);

    try {
      if (qualifiedIds.length > 0) {
        await supabase.from('submissions').update({ is_qualified: true }).in('id', qualifiedIds);
      }
      if (disqualifiedIds.length > 0) {
        await supabase.from('submissions').update({ is_qualified: false }).in('id', disqualifiedIds);
      }
      await fetchRankings();
    } catch (err) {
      console.error("Error setting qualifications:", err);
      alert("Failed to update qualifications.");
    } finally {
      setIsQualifying(false);
    }
  };

  const formatTime = (seconds) => {
    if (!seconds && seconds !== 0) return 'N/A';
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins}m ${secs}s`;
  };

  const getRankBadge = (rank) => {
    if (rank === 1) return <span className="p-1.5 rounded-lg bg-amber-100 text-amber-800 font-black"><Medal className="w-4 h-4 inline mr-1 text-amber-600" />#1</span>;
    if (rank === 2) return <span className="p-1.5 rounded-lg bg-slate-200 text-slate-700 font-bold"><Medal className="w-4 h-4 inline mr-1 text-slate-500" />#2</span>;
    if (rank === 3) return <span className="p-1.5 rounded-lg bg-amber-700/10 text-amber-900 font-bold"><Medal className="w-4 h-4 inline mr-1 text-amber-700" />#3</span>;
    return <span className="text-zinc-500 font-semibold pl-2">#{rank}</span>;
  };

  return (
    <div className="max-w-5xl mx-auto p-8 space-y-6">
      <div className="flex justify-between items-center border-b border-zinc-200/80 pb-5">
        <div>
          <Link to="/admin" className="inline-flex items-center gap-1.5 text-teal-800 hover:text-teal-900 text-xs font-bold mb-2 transition">
            <ArrowLeft className="w-3.5 h-3.5" /> Back to Console
          </Link>
          <div className="flex items-center gap-2.5">
            <Trophy className="w-6 h-6 text-amber-600" />
            <h1 className="text-xl font-bold text-zinc-900">
              Official Leaderboard: {exam ? exam.title : 'Loading...'}
            </h1>
          </div>
        </div>
        <div className="text-xs text-zinc-500 bg-zinc-50 border border-zinc-200 px-3 py-1.5 rounded-lg">
          Rank Criteria: <strong>Score (High)</strong> → <strong>Time Taken (Fastest)</strong>
        </div>
      </div>

      {/* QUALIFICATION CONTROL PANEL */}
      <div className="bg-white border border-indigo-100 rounded-2xl p-5 shadow-sm flex items-center justify-between">
        <div>
          <h3 className="text-sm font-bold text-zinc-900 flex items-center gap-2">
            <Users className="w-4 h-4 text-indigo-600" /> Competition Cutoff
          </h3>
          <p className="text-xs text-zinc-500 mt-1">Select the top candidates to move on to the next round. (Optional)</p>
        </div>
        <div className="flex items-center gap-3">
          <div className="flex items-center gap-2 bg-zinc-50 border border-zinc-200 rounded-xl px-3 py-1.5">
            <span className="text-xs font-bold text-zinc-600">Top</span>
            <input 
              type="number" 
              min="1" 
              value={topK} 
              onChange={(e) => setTopK(parseInt(e.target.value) || 1)}
              className="w-16 bg-white border border-zinc-300 rounded-md px-2 py-1 text-sm font-bold text-center outline-none focus:border-indigo-500"
            />
            <span className="text-xs font-bold text-zinc-600">Candidates</span>
          </div>
          <button 
            onClick={handleQualifyTopK}
            disabled={isQualifying || rankings.length === 0}
            className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition shadow-sm disabled:opacity-50"
          >
            {isQualifying ? 'Processing...' : 'Mark as Qualified'}
          </button>
        </div>
      </div>

      <div className="bg-white rounded-2xl border border-zinc-200/80 overflow-hidden shadow-xs">
        <table className="w-full text-left text-xs">
          <thead className="bg-zinc-50 border-b border-zinc-200 text-zinc-600 uppercase font-bold tracking-wider text-[11px]">
            <tr>
              <th className="p-4">Rank</th>
              <th className="p-4">Candidate</th>
              <th className="p-4">Score</th>
              <th className="p-4">Time Taken</th>
              <th className="p-4">Status</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-zinc-100 font-medium">
            {loading ? (
              <tr><td colSpan="5" className="p-6 text-center text-zinc-400">Loading standings...</td></tr>
            ) : rankings.length === 0 ? (
              <tr><td colSpan="5" className="p-8 text-center text-zinc-400">No qualifying submissions recorded.</td></tr>
            ) : (
              rankings.map((row, idx) => (
                <tr key={row.id} className={`transition ${row.is_qualified ? 'bg-emerald-50/30' : 'hover:bg-zinc-50/70'}`}>
                  <td className="p-4">{getRankBadge(idx + 1)}</td>
                  <td className="p-4">
                    <span className="font-bold text-zinc-900 block">{row.student_name}</span>
                    <span className="text-[11px] text-zinc-400">{row.student_email}</span>
                  </td>
                  <td className="p-4">
                    <span className="inline-flex items-center gap-1 font-extrabold text-teal-800 bg-teal-50 px-2.5 py-1 rounded-md border border-teal-100">
                      <Award className="w-3.5 h-3.5 text-teal-600" />
                      {row.score}
                    </span>
                  </td>
                  <td className="p-4 text-zinc-600">
                    <span className="inline-flex items-center gap-1 font-semibold">
                      <Clock className="w-3.5 h-3.5 text-zinc-400" />
                      {formatTime(row.time_taken_seconds)}
                    </span>
                  </td>
                  <td className="p-4">
                    {row.is_qualified === true && (
                      <span className="inline-flex items-center gap-1 text-emerald-700 font-bold text-[10px] uppercase bg-emerald-100 px-2 py-0.5 rounded border border-emerald-200">
                        <CheckCircle2 className="w-3 h-3" /> Qualified
                      </span>
                    )}
                    {row.is_qualified === false && (
                      <span className="inline-flex items-center gap-1 text-zinc-500 font-bold text-[10px] uppercase bg-zinc-100 px-2 py-0.5 rounded border border-zinc-200">
                        <XCircle className="w-3 h-3" /> Not Qualified
                      </span>
                    )}
                    {row.is_qualified === null && (
                      <span className="text-zinc-400 text-[10px] italic">Pending</span>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}
</file>

<file path="src/pages/EditExam.jsx">
import React, { useState, useEffect } from 'react';
import { useNavigate, useParams, Link } from 'react-router-dom';
import { supabase } from '../lib/supabaseClient';
import { useAuth } from '../context/AuthContext';
import { 
  ArrowLeft, Plus, Trash2, CheckCircle2, 
  Layers, Clock, AlertCircle, Tag, Sparkles 
} from 'lucide-react';

export default function EditExam() {
  const { examId } = useParams();
  const { user } = useAuth();
  const navigate = useNavigate();

  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [durationMinutes, setDurationMinutes] = useState(30);
  const [isPublished, setIsPublished] = useState(false);
  const [showResults, setShowResults] = useState(false);
  const [showDetailedResults, setShowDetailedResults] = useState(false);
  const [showLeaderboard, setShowLeaderboard] = useState(false);
  
  const [hasCategories, setHasCategories] = useState(false);
  const [categoryTitle, setCategoryTitle] = useState('Select Your Track');
  const [categoryMessage, setCategoryMessage] = useState('Please select the track you wish to be tested on. You cannot change this later.');
  
  const [allowAiAssistant, setAllowAiAssistant] = useState(false);
  // NEW: Dynamic AI Configuration State
  const [aiWordLimit, setAiWordLimit] = useState(200);
  const [aiAttemptsLimit, setAiAttemptsLimit] = useState(2);

  const [questions, setQuestions] = useState([]);
  const [loading, setLoading] = useState(true);
  const [isSaving, setIsSaving] = useState(false);
  const [errorMsg, setErrorMsg] = useState('');

  useEffect(() => {
    const fetchExamDetails = async () => {
      try {
        const { data: examData, error: examErr } = await supabase
          .from('exams')
          .select('*')
          .eq('id', examId)
          .single();

        if (examErr) throw examErr;

        setTitle(examData.title || '');
        setDescription(examData.description || '');
        setDurationMinutes(examData.duration_minutes || 30);
        setIsPublished(examData.is_published || false);
        setShowResults(examData.show_results || false);
        setShowDetailedResults(examData.show_detailed_results || false);
        setShowLeaderboard(examData.show_leaderboard || false);
        
        setHasCategories(examData.has_categories || false);
        setCategoryTitle(examData.category_selection_title || 'Select Your Track');
        setCategoryMessage(examData.category_selection_message || 'Please select the track you wish to be tested on. You cannot change this later.');
        
        setAllowAiAssistant(examData.allow_ai_assistant || false);
        setAiWordLimit(examData.ai_word_limit || 500); // Load AI limit
        setAiAttemptsLimit(examData.ai_attempts_limit || 2); // Load AI count

        const { data: qData, error: qErr } = await supabase
          .from('questions')
          .select('*')
          .eq('exam_id', examId)
          .order('created_at', { ascending: true });

        if (qErr) throw qErr;

        if (qData && qData.length > 0) {
          setQuestions(qData.map(q => ({
            question_text: q.question_text,
            type: q.type,
            options: q.options || ['', '', '', ''],
            correct_answers: q.correct_answers || [0],
            marks: q.marks,
            negative_marks: q.negative_marks,
            category: q.category || 'General'
          })));
        } else {
          setQuestions([{
            question_text: '', type: 'single', options: ['', '', '', ''],
            correct_answers: [0], marks: 1, negative_marks: 0, category: 'General'
          }]);
        }
      } catch (err) {
        console.error(err);
        setErrorMsg("Failed to load exam data.");
      } finally {
        setLoading(false);
      }
    };

    fetchExamDetails();
  }, [examId]);

  const addQuestion = () => {
    setQuestions([...questions, {
      question_text: '', type: 'single', options: ['', '', '', ''],
      correct_answers: [0], marks: 1, negative_marks: 0, category: 'General'
    }]);
  };

  const removeQuestion = (index) => {
    if (questions.length === 1) return alert('An assessment must have at least one question.');
    setQuestions(questions.filter((_, idx) => idx !== index));
  };

  const handleQuestionFieldChange = (index, field, value) => {
    const updated = [...questions];
    updated[index][field] = value;
    setQuestions(updated);
  };

  const handleTypeChange = (index, newType) => {
    const updated = [...questions];
    updated[index].type = newType;
    if (newType === 'boolean') {
      updated[index].options = ['True', 'False'];
      updated[index].correct_answers = [0];
    } else if (newType === 'text') {
      updated[index].options = [];
      updated[index].correct_answers = [];
    } else {
      updated[index].options = ['', '', '', ''];
      updated[index].correct_answers = [0];
    }
    setQuestions(updated);
  };

  const handleOptionChange = (qIndex, oIndex, value) => {
    const updated = [...questions];
    updated[qIndex].options[oIndex] = value;
    setQuestions(updated);
  };

  const handleCorrectAnswerToggle = (qIndex, oIndex) => {
    const updated = [...questions];
    const currentQ = updated[qIndex];
    if (currentQ.type === 'single' || currentQ.type === 'boolean') {
      currentQ.correct_answers = [oIndex];
    } else if (currentQ.type === 'multiple') {
      const exists = currentQ.correct_answers.includes(oIndex);
      if (exists) {
        if (currentQ.correct_answers.length > 1) {
          currentQ.correct_answers = currentQ.correct_answers.filter((i) => i !== oIndex);
        }
      } else {
        currentQ.correct_answers = [...currentQ.correct_answers, oIndex].sort();
      }
    }
    setQuestions(updated);
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setErrorMsg('');

    if (!title.trim()) return setErrorMsg('Please enter an assessment title.');

    for (let i = 0; i < questions.length; i++) {
      const q = questions[i];
      if (!q.question_text.trim()) return setErrorMsg(`Question #${i + 1} is missing question text.`);
      
      if (q.type !== 'text') {
        for (let j = 0; j < q.options.length; j++) {
          if (!q.options[j].trim()) return setErrorMsg(`Question #${i + 1}, Option #${j + 1} cannot be empty.`);
        }
        if (q.correct_answers.length === 0) return setErrorMsg(`Question #${i + 1} must have at least one correct option.`);
      }
    }

    setIsSaving(true);

    try {
      const { error: examErr } = await supabase
        .from('exams')
        .update({
          title: title.trim(),
          description: description.trim(),
          duration_minutes: parseInt(durationMinutes, 10),
          is_published: isPublished,
          show_results: showResults,
          show_detailed_results: showDetailedResults,
          show_leaderboard: showLeaderboard,
          has_categories: hasCategories,
          category_selection_title: categoryTitle.trim(),
          category_selection_message: categoryMessage.trim(),
          allow_ai_assistant: allowAiAssistant,
          ai_word_limit: parseInt(aiWordLimit, 10), // Save AI Limit
          ai_attempts_limit: parseInt(aiAttemptsLimit, 10), // Save AI Count
        })
        .eq('id', examId);

      if (examErr) throw examErr;

      const { error: delErr } = await supabase.from('questions').delete().eq('exam_id', examId);
      if (delErr) throw delErr;

      const questionsPayload = questions.map((q) => ({
        exam_id: examId,
        question_text: q.question_text.trim(),
        type: q.type,
        options: q.options.map((opt) => opt.trim()),
        correct_answers: q.correct_answers,
        marks: parseFloat(q.marks),
        negative_marks: parseFloat(q.negative_marks),
        category: hasCategories ? q.category.trim() : 'General',
      }));

      const { error: qErr } = await supabase.from('questions').insert(questionsPayload);
      if (qErr) throw qErr;

      navigate('/admin');
    } catch (err) {
      console.error(err);
      setErrorMsg(err.message || 'Failed to update assessment.');
    } finally {
      setIsSaving(false);
    }
  };

  if (loading) return <div className="min-h-screen flex items-center justify-center text-zinc-500 font-medium">Loading Assessment Data...</div>;

  return (
    <div className="max-w-4xl mx-auto p-6 md:p-8 space-y-6">
      <div className="flex items-center justify-between border-b border-zinc-200/80 pb-4">
        <div>
          <Link to="/admin" className="inline-flex items-center gap-1 text-teal-800 hover:text-teal-900 text-xs font-bold mb-1 transition">
            <ArrowLeft className="w-3.5 h-3.5" /> Back to Console
          </Link>
          <h1 className="text-xl font-bold text-zinc-900">Edit Assessment</h1>
        </div>
      </div>

      {errorMsg && (
        <div className="p-4 bg-red-50 border border-red-200 text-red-700 text-xs font-medium rounded-xl flex items-center gap-2">
          <AlertCircle className="w-4 h-4 shrink-0 text-red-600" />
          <span>{errorMsg}</span>
        </div>
      )}

      <form onSubmit={handleSubmit} className="space-y-6">
        <div className="bg-white border border-zinc-200/80 rounded-2xl p-6 shadow-xs space-y-4">
          <div className="flex items-center gap-2 border-b border-zinc-100 pb-3">
            <Layers className="w-4 h-4 text-teal-800" />
            <h2 className="text-sm font-bold text-zinc-900 uppercase tracking-wider">Assessment Settings</h2>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="md:col-span-2 space-y-1">
              <label className="text-xs font-semibold text-zinc-700">Exam Title</label>
              <input type="text" required value={title} onChange={(e) => setTitle(e.target.value)} className="w-full px-3.5 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-xs font-medium text-zinc-900 focus:ring-2 focus:ring-teal-700/20 focus:border-teal-700" />
            </div>

            <div className="md:col-span-2 space-y-1">
              <label className="text-xs font-semibold text-zinc-700">Instructions / Description</label>
              <textarea rows={2} value={description} onChange={(e) => setDescription(e.target.value)} className="w-full px-3.5 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-xs font-medium text-zinc-900 focus:ring-2 focus:ring-teal-700/20 focus:border-teal-700 resize-none" />
            </div>

            <div className="space-y-1">
              <label className="text-xs font-semibold text-zinc-700">Duration (Minutes)</label>
              <div className="relative">
                <input type="number" min={1} required value={durationMinutes} onChange={(e) => setDurationMinutes(e.target.value)} className="w-full pl-9 pr-3.5 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-xs font-medium text-zinc-900 focus:ring-2 focus:ring-teal-700/20 focus:border-teal-700" />
                <Clock className="w-4 h-4 text-zinc-400 absolute left-3 top-3" />
              </div>
            </div>

            <div className="grid grid-cols-2 gap-2 pt-2 md:col-span-2">
              <label className="flex items-center gap-2 p-3 bg-zinc-50 border border-zinc-200/80 rounded-xl text-xs font-semibold text-zinc-800 cursor-pointer">
                <input type="checkbox" checked={isPublished} onChange={(e) => setIsPublished(e.target.checked)} className="w-4 h-4 accent-teal-700" /> Published
              </label>
              <label className="flex items-center gap-2 p-3 bg-zinc-50 border border-zinc-200/80 rounded-xl text-xs font-semibold text-zinc-800 cursor-pointer">
                <input type="checkbox" checked={showResults} onChange={(e) => setShowResults(e.target.checked)} className="w-4 h-4 accent-teal-700" /> Release Score to Students
              </label>
